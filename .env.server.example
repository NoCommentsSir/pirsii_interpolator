# Copy this file to .env on the server and replace every placeholder secret/domain.

# Public DNS names. Both A records must point to the server public IP.
APP_DOMAIN=app.example.com
FILES_DOMAIN=files.example.com

# Redis
REDIS_HOST=redis-db
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_QUEUE_NAME=interpolation_tasks

# PostgreSQL
POSTGRES_HOST=pg-db
POSTGRES_PORT=5432
POSTGRES_USER=interpolator
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=video_interpolation

# MinIO internal storage and public presigned download host.
MINIO_HOST=minio-db
MINIO_API_PORT=9000
MINIO_PORT=9001
MINIO_ROOT_USER=interpolator
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_NAME=videos
MINIO_PUBLIC_ENDPOINT=${FILES_DOMAIN}
MINIO_PUBLIC_SECURE=true
MINIO_REGION=us-east-1

# Backend/API
CORS_ALLOWED_ORIGINS=https://${APP_DOMAIN}

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-password

# Worker -> Practical-RIFE BentoML contract.
# GPU-specific worker services set RIFE_SERVICE_URL in docker-compose.gpu.generated.yml.
RIFE_API_PATH=/interpolate_video
RIFE_REQUEST_TIMEOUT=1800
RIFE_SHARED_DIR=/shared/rife
RIFE_KEEP_JOB_DIR=false

# Practical-RIFE BentoML runtime.
RIFE_DEVICE=cuda
RIFE_CODEC=h264_nvenc
MODEL_WEIGHTS_ROOT=/app/model_weights
MODEL_REPOS_ROOT=/app/model_repos
DATASET_ROOT=/app/datasets
BENTOML_HOST=0.0.0.0
BENTOML_PORT=3000
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
