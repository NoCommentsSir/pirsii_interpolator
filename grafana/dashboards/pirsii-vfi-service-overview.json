          "rawSql": "WITH latencies AS (SELECT $__timeGroup(uploaded_at, '5m') AS time, EXTRACT(EPOCH FROM (processed_at - uploaded_at)) AS latency_sec FROM video_interpolation.input_videos WHERE processed_at IS NOT NULL AND $__timeFilter(uploaded_at)) SELECT time, AVG(latency_sec) AS avg_latency_sec, percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_sec) AS p50_latency_sec, percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_sec) AS p95_latency_sec FROM latencies GROUP BY time ORDER BY time;",
